\mode<presentation>

\setbeamertemplate{background}{
}

% Title page
\defbeamertemplate*{title page}{henri-astro}[1][]
{ 
  \thispagestyle{empty} %remove line number from title page

  \makebox[\linewidth]{
    \centering\includegraphics[width=\paperwidth]{bgtitlepage.jpg}
  }

  \begin{tikzpicture}[remember picture,overlay]

  % Title near top
  \node[anchor=north, yshift=-1cm, text width=\textwidth, align=center] at (current page.north) {
    {\usebeamerfont{title}\inserttitle}\\[0.3cm]
    {\usebeamerfont{author}\insertauthor}
  };

  % Date near bottom
  \node[anchor=south, yshift=1cm, text width=\textwidth, align=left] at (current page.south) {
    {\usebeamerfont{author}\insertdate}
  };

  \end{tikzpicture}
  
  \vspace*{\paperheight}  %latex apparently needs this to not mess everything up...
}

% Items and blocks
\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[sections numbered]
\setbeamertemplate{blocks}[default]

%captions
\setbeamertemplate{caption}{\raggedright\insertcaption\par}

\mode
<all>
